"""Web scraper: collects book data from https://books.toscrape.com (a site built for scraping practice)."""
import argparse
import csv
import time
from urllib.parse import urljoin

import requests
from bs4 import BeautifulSoup

BASE = "https://books.toscrape.com/catalogue/page-{}.html"
RATINGS = {"One": 1, "Two": 2, "Three": 3, "Four": 4, "Five": 5}
HEADERS = {"User-Agent": "Mozilla/5.0 (CodeAlpha internship scraper)"}


def parse_books(html: str, page_url: str = "https://books.toscrape.com/catalogue/"):
    """Return a list of dicts, one per book found in a listing page's HTML."""
    soup = BeautifulSoup(html, "html.parser")
    books = []
    for card in soup.select("article.product_pod"):
        link = card.h3.a
        rating_cls = [c for c in card.select_one("p.star-rating")["class"] if c != "star-rating"]
        price = card.select_one("p.price_color").get_text(strip=True)
        books.append({
            "title": link["title"],
            "price_gbp": float("".join(ch for ch in price if ch.isdigit() or ch == ".")),
            "rating": RATINGS.get(rating_cls[0], 0) if rating_cls else 0,
            "in_stock": "In stock" in card.select_one("p.availability").get_text(),
            "url": urljoin(page_url, link["href"]),
        })
    return books


def scrape(max_pages: int, delay: float = 0.5):
    all_books = []
    for page in range(1, max_pages + 1):
        resp = requests.get(BASE.format(page), headers=HEADERS, timeout=15)
        if resp.status_code == 404:  # ran past the last page
            break
        resp.raise_for_status()
        books = parse_books(resp.text)
        print(f"Page {page}: {len(books)} books")
        all_books.extend(books)
        time.sleep(delay)  # be polite to the server
    return all_books


def save_csv(rows, path):
    if not rows:
        print("Nothing to save.")
        return
    with open(path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=rows[0].keys())
        writer.writeheader()
        writer.writerows(rows)
    print(f"Saved {len(rows)} rows to {path}")


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="Scrape books.toscrape.com into a CSV dataset")
    ap.add_argument("--pages", type=int, default=50, help="number of listing pages (max 50)")
    ap.add_argument("--out", default="books.csv")
    args = ap.parse_args()
    save_csv(scrape(args.pages), args.out)